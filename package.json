{
  "name": "ss-journey-platform",
  "version": "1.0.0",
  "private": true,
  "description": "SS Journey (SuccessSign Journey) — Professional Scalable Travel Booking Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@traveler/web run dev --",
    "dev:web": "npm --workspace=@traveler/web run dev --",
    "dev:admin": "npm --workspace=@traveler/admin run dev --",
    "dev:mobile": "npm --workspace=mobile run start",
    "mobile:web": "npm --workspace=mobile run web",
    "dev:partner": "npm --workspace=@traveler/partner run start",
    "partner:web": "npm --workspace=@traveler/partner run web",
    "dev:backend": "npm --workspace=@traveler/server run dev",
    "dev:backend:py": "uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 8000",
    "backend:seed": "npm --workspace=@traveler/server run seed",
    "backend:seed:py": "python -m backend.seed",
    "build:web": "npm --workspace=@traveler/web run build",
    "build:admin": "npm --workspace=@traveler/admin run build",
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test"
  },
  "keywords": [
    "travel",
    "flights",
    "hotels",
    "booking",
    "ssjourney"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.12"
  }
}
