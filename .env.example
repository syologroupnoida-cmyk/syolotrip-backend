# ==========================================
# TRAVEL PLATFORM - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex

# API Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="Traveler Platform"

# Frontend URLs for CORS
FRONTEND_WEB_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://user:password@localhost:5432/dbname
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=traveler_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/traveler_db

# Fallback for isolated local test runs (when PostgreSQL is offline):
# DATABASE_URL=sqlite+aiosqlite:///./test.db

# Authentication / JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Travel Mock Mode
USE_MOCK_PROVIDERS=true
