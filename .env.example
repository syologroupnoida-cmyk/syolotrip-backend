# ==============================================================================
# SS JOURNEY / TRAVELER PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTES:
# 1. Never commit your actual '.env' file or production credentials to Git.
# 2. In staging/production, DEBUG must be set to 'false'.
# 3. In staging/production, SECRET_KEY must be at least 32 cryptographically
#    random bytes (e.g. generated via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# ==============================================================================

# Application Environment ('development' | 'staging' | 'production')
ENVIRONMENT=development

# Debug Mode (Defaults to false in core settings; must remain false in production)
DEBUG=false

# JWT Secret Key
# In development, defaults to a development fallback key with an audit warning.
# In staging/production, startup will fail if this is missing or insecure (<32 bytes).
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex

# Authentication / JWT Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Optional Development Seeding Configuration (used by apps/server/src/seed.ts)
# Note: ADMIN_PASSWORD is never used as an authentication bypass; all logins
# verify against the database bcrypt hash.
ADMIN_EMAIL=admin@ssjourney.com
# ADMIN_PASSWORD=ADMIN~321

# API Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="SS Journey API"

# Allowed CORS Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# Frontend URLs (Reference)
FRONTEND_WEB_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=traveler_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traveler_db

# Provider Simulation Mode (true = use mock flight/hotel inventories)
USE_MOCK_PROVIDERS=true

# ==============================================================================
# Razorpay Payment Gateway (Test Mode / Production)
# ==============================================================================
# Generate keys from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
# Never commit real keys or secrets to Git.
RAZORPAY_KEY_ID=rzp_test_replaceWithYourKeyId
RAZORPAY_KEY_SECRET=replaceWithYourKeySecret
# Optional: Webhook Secret from Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=replaceWithYourWebhookSecret

